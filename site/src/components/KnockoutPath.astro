---
import { sides, dparts } from '../lib/data.js';
const { S } = Astro.props;
const NW = 192, NH = 88, CW = 232, RH = 114, TOP = 22;
const nodes = S.ko.nodes;
const pos = Object.fromEntries(nodes.map(n => [n.id, { x: n.col * CW, y: n.row * RH + TOP }]));
const W = 4 * CW + NW + 4;
const H = Math.max(...nodes.map(n => pos[n.id].y)) + NH + 44;
const idxOf = (to, from) => nodes.find(n => n.id === to).slots.findIndex(s => s.match === from);
const edges = S.ko.edges.map(e => {
  const a = pos[e.from], b = pos[e.to];
  const x1 = a.x + NW, y1 = a.y + (e.take === 'winner' ? NH * 0.36 : NH * 0.66);
  const x2 = b.x, y2 = b.y + 26 + 14 + idxOf(e.to, e.from) * 28;
  const mx = (x1 + x2) / 2;
  const done = S.matchMap[e.from]?.status === 'finished';
  return { d: `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`, take: e.take, done };
});
---
<div class="pathscroll"><div class="ko" style={`width:${W}px;height:${H}px`}>
  <svg class="conn" width={W} height={H}>{edges.map(e => <path d={e.d} class={`${e.take === 'winner' ? 'w' : 'l'} ${e.done ? 'done' : ''}`} />)}</svg>
  {nodes.map(n => { const m = n.match; const ss = sides(S, m); const d = dparts(m.time); const fin = m.status === 'finished', live = m.status === 'live';
    return <a class={`kn ${m.status} g-${n.group}`} href={`/${S.slug}/match/${m.id}/`} style={`left:${pos[n.id].x}px;top:${pos[n.id].y}px;width:${NW}px;height:${NH}px`}>
      <div class="knh"><span>{n.name}{n.group === 'f' ? ' ★' : ''}</span>{live ? <b class="lv">LIVE</b> : fin ? <em>BO{n.bo}</em> : <em>{d.date} {d.time}</em>}</div>
      {ss.map((s, i) => { const win = fin && m.winner && (i === 0 ? m.teamA : m.teamB) === m.winner;
        return <div class={`knr ${fin ? (win ? 'w' : 'l') : ''}`}>
          {s.team ? <span class="tm"><img src={`/assets/teams/${s.team.logo}`} alt="" loading="lazy" /><span class="nm">{s.team.name}</span></span> : <span class="tm ph"><span class="dot"></span><span class="nm">{s.label}</span></span>}
          <b class="num">{fin || live ? (i === 0 ? m.scoreA : m.scoreB) : ''}</b>
        </div>; })}
      {(n.place || n.winnerPlace) && <div class="knp">{n.winnerPlace ? `胜 → ${n.winnerPlace}　` : ''}{n.place ? `败 → ${n.place}` : ''}</div>}
    </a>; })}
</div></div>
<div class="legend"><span><i class="lw"></i>晋级下一轮</span><span><i class="ll"></i>败者降入败者组</span><span class="muted">点击比赛查看详情</span></div>
